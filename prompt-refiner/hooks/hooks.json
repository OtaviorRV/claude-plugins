{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/prompt-refiner.js", "${CLAUDE_PLUGIN_DATA}"],
            "timeout": 120,
            "statusMessage": "Refinando a mensagem..."
          }
        ]
      }
    ]
  }
}
